# Large firmware-style thermal blobs use Git LFS when the clone is configured for LFS.
thermal-data/**/*.img filter=lfs diff=lfs merge=lfs -text
generated-thermal/**/*.img filter=lfs diff=lfs merge=lfs -text
thermal-data/**/*.bin filter=lfs diff=lfs merge=lfs -text
generated-thermal/**/*.bin filter=lfs diff=lfs merge=lfs -text
