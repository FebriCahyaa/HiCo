# Audio
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
ro.audio.monitorRotation=true
ro.audio.usb.period_us=16000

# Bluetooth
ro.bt.bdaddr_path=/data/vendor/bluetooth/bdaddr

# Camera
camera.disable_zsl_mode=1

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# Display
debug.mediatek.disp_decompress=1
ro.hardware.egl=mali
ro.opengles.version=196610
ro.vendor.mtk_hdr_video_support=1
ro.vendor.mtk_pq_color_mode=1
ro.vendor.mtk_pq_support=2

# Fingerprint
persist.vendor.fingerprint.type=side
ro.hardware.fingerprint=goodix

# Media
ro.vendor.mtk_config_max_dram_size=0x800000000

# Recovery
ro.minui.blacklist_input_devices=ilitek_hid-over-i2c 222A:FFF1 Stylus

# SurfaceFlinger
debug.sf.enable_hwc_vds=1
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.supports_background_blur=1

# TEE
ro.vendor.mtk_op_tee_support=1

# USB
vendor.usb.controller=112b1000.usb

# Wi-Fi
ro.vendor.wifi.sap.interface=ap0
