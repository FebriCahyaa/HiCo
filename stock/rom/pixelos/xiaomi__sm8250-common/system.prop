# Audio
ro.audio.usb.period_us=20000

# Camera
camera.disable_zsl_mode=true
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.android.camera,org.lineageos.aperture,org.lineageos.aperture.dev

# CNE
persist.vendor.cne.feature=1

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# Disable Skia tracing by default
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

# Display
debug.sf.enable_hwc_vds=0
debug.sf.predict_hwc_composition_strategy=0

# DPM
persist.vendor.dpm.feature=1

# Fwk detect
ro.vendor.qti.va_aosp.support=1

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# LMK
ro.lmk.filecache_min_kb=153600
ro.lmk.kill_timeout_ms=200
ro.lmk.lowmem_min_oom_score=900
ro.lmk.psi_partial_stall_ms=200
ro.lmk.swap_free_low_percentage=7

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# Netflix
ro.netflix.bsp_rev=Q8250-19134-1

# Thermal
vendor.sys.thermal.data.path=/data/vendor/thermal/

# Zygote
persist.device_config.runtime_native.usap_pool_enabled=true
